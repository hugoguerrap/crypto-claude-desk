{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash ../bin/sync-plugin-db.sh || true",
    "dev": "concurrently -n next,pty -c blue,magenta \"next dev\" \"node server/pty-server.mjs\"",
    "dev:next": "next dev",
    "dev:pty": "node server/pty-server.mjs",
    "sync-db": "bash ../bin/sync-plugin-db.sh",
    "sync-db:status": "bash ../bin/sync-plugin-db.sh --status",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tailwindcss/typography": "^0.5.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "node-pty": "^1.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ws": "^8.20.1"
  }
}
